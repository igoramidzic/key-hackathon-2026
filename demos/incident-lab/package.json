{
  "name": "relay-incident-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "start": "tsx server.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:cloud": "vite build --mode cloud && tsc --noEmit -p tsconfig.worker.json",
    "deploy": "npm run build:cloud && cf deploy --prebuilt --mode cloud",
    "dev:cloud": "vite --mode cloud --port 8787"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.12",
    "@types/node": "^22.0.0",
    "cf": "^0.15.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
