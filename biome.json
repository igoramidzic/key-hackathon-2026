{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/.turbo", "!**/node_modules", "!**/*.md", "!demo"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "off"
      },
      "a11y": {
        "useButtonType": "off",
        "noSvgWithoutTitle": "off",
        "useKeyWithClickEvents": "off",
        "noStaticElementInteractions": "off",
        "useSemanticElements": "off",
        "noLabelWithoutControl": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/incident-agent/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@sim/scenarios": "Answer key: the incident agent must find root causes from logs, ServiceNow and GitLab.",
                  "@sim/contracts/simulator": "Answer key: only apps/incident-agent/eval may use the simulator API.",
                  "@sim/simulator": "Answer key: only apps/incident-agent/eval may use the simulator.",
                  "@sim/world": "Use the CMDB over MCP (search_apps, get_app) instead of the seeded world."
                },
                "patterns": [
                  {
                    "group": ["@sim/scenarios/**", "@sim/simulator/**", "@sim/world/**"],
                    "message": "Answer key: the incident agent may only reach the world through MCP and the live feeds."
                  },
                  {
                    "group": [
                      "**/packages/scenarios/**",
                      "**/apps/simulator/**",
                      "**/packages/world/**"
                    ],
                    "message": "Answer key: the incident agent may only reach the world through MCP and the live feeds."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
